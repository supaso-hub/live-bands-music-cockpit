# Proteger archivos sensibles en Apache / LiteSpeed (Hostinger)
<FilesMatch "(catalog\.private\.json|\.env|\.git|composer\.|package\.json)">
    Require all denied
</FilesMatch>

# Configuración de tipos MIME para audio y fuentes
AddType audio/mpeg .mp3
AddType audio/wav .wav
AddType font/woff2 .woff2

# Seguridad de cabeceras básicas
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
